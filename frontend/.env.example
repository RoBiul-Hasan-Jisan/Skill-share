# Frontend (Next.js) — copy to .env.local and fill in your values.
# Leave everything blank for local demo mode (mock data, no backend, no socket).

# Used server-side by next.config.js to proxy /api/* to your Express backend.
BACKEND_URL=http://localhost:4000

# Used client-side (must be prefixed NEXT_PUBLIC_ to reach the browser).
# If unset, the app falls back to relative /api calls via the proxy above.
NEXT_PUBLIC_API_URL=/api

# If unset, chat runs in local demo mode (no live socket connection).
NEXT_PUBLIC_SOCKET_URL=https://your-backend.onrender.com

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
